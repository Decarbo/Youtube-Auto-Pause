{
   "manifest_version": 3,
   "name": "YouTube Auto Pause",
   "version": "1.0",
   "description": "Automatically pauses YouTube videos when switching tabs and resumes when returning",
   "permissions": [
      "tabs",
      "storage"
   ],
   "host_permissions": [
      "*://*.youtube.com/*"
   ],
   "action": {
      "default_popup": "popup.html",
      "default_icon": {
         "16": "icon16.png",
         "48": "icon48.png",
         "128": "icon128.png"
      }
   },
   "content_scripts": [
      {
         "matches": [
            "*://*.youtube.com/*"
         ],
         "js": [
            "content.js"
         ]
      }
   ]
}
